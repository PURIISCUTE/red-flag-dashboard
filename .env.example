# RedFlag Terminal Environment Configuration
# SEC EDGAR Requirements (Declared User-Agent email is strictly required by the SEC)
SEC_USER_AGENT=RedFlagTerminal forensic@redflagterminal.com

# Kaggle Dataset API (For cross-sectional fraud baseline benchmarks)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Frontend Allowed Origin
FRONTEND_URL=https://redflag-terminal-web.vercel.app

# Database Connection (Render PostgreSQL or Cloud SQL)
DATABASE_URL=postgresql://user:password@localhost:5432/redflag_terminal
